INSERT OR REPLACE INTO User_Profiles (
  auth_user_id, nickname, role_level, branch_id, created_at, 
  password_hash, force_password_change
) VALUES (
  'admin_sicc_2026',
  'ADMIN',
  5,
  'MAIN_BRANCH',
  CURRENT_TIMESTAMP,
  '$2b$12$bOaRs7EsjziDkXs/EGy/t.TAOdKMlJ5aJ2JvMgQybc.jnWm3Zxa7C', -- SecurePass2026! (bcrypt 12 rounds, corregido Fase 5)
  TRUE
);

-- Insertar evento de migración en el log de auditoría
INSERT INTO security_audit_log (
  auth_user_id,
  event_type,
  ip_address,
  details,
  success
) VALUES (
  'system',
  'SECURITY_MIGRATION',
  'localhost',
  '{"migration": "auth_security_v1", "timestamp": "' || datetime('now') || '"}',
  TRUE
);